# ============================================================
#  PharmaConnect — configuration locale (Laragon / XAMPP)
#  Copier ce fichier en .env puis lancer : php artisan key:generate
# ============================================================

APP_NAME=PharmaConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Douala
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_CM

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------
#  Base de données — MySQL (Laragon/XAMPP) PAR DÉFAUT
#  Créer la base : CREATE DATABASE pharmaconnect;
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharmaconnect
DB_USERNAME=root
DB_PASSWORD=

# --- ALTERNATIVE : SQLite, zéro serveur ---
# Commentez le bloc MySQL ci-dessus puis décommentez :
# DB_CONNECTION=sqlite
# DB_DATABASE=${APP_BASE_PATH}/database/database.sqlite
# DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Files d'attente : driver database (php artisan queue:work)
QUEUE_CONNECTION=database
CACHE_STORE=file

# ------------------------------------------------------------
#  Temps réel : Laravel Reverb (messagerie, suivi de livraison,
#  notifications). Lancer : php artisan reverb:start
# ------------------------------------------------------------
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public

REVERB_APP_ID=pharmaconnect
REVERB_APP_KEY=pharmaconnect-local-key
REVERB_APP_SECRET=pharmaconnect-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------
#  E-mails : écrits dans storage/logs/laravel.log en local
# ------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pharmaconnect.cm"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
#  Acteurs externes — implémentations MOCK 100 % local
#  (aucun service cloud requis). Pour brancher une vraie
#  passerelle (MTN MoMo, Orange Money, SMS…), remplacer 'mock'
#  et implémenter l'interface correspondante dans app/Services.
# ------------------------------------------------------------
PAYMENT_GATEWAY=mock
SMS_GATEWAY=mock
CHATBOT_SERVICE=mock

# Numéros marchands simulés affichés sur l'écran de paiement
MOCK_MOMO_PAYEE_NUMBER=670000000
MOCK_ORANGE_PAYEE_NUMBER=690000000
